LSOC_ENVIRONMENT=development
LSOC_POSTGRES_PORT=5433
LSOC_DATABASE_URL=postgresql+psycopg://lsoc:lsoc@localhost:5433/lsoc
LSOC_SECRET_KEY=development-only-change-this-secret-before-deployment
LSOC_FRONTEND_URL=http://localhost:5173
LSOC_CORS_ORIGINS=["http://localhost:5173"]
LSOC_COOKIE_SECURE=false
LSOC_SESSION_IDLE_DAYS=7
LSOC_SMTP_HOST=localhost
LSOC_SMTP_PORT=1025
LSOC_SMTP_USERNAME=
LSOC_SMTP_PASSWORD=
LSOC_SMTP_STARTTLS=false
LSOC_SMTP_FROM=LSOC <noreply@lsoc.local>
LSOC_WORKER_POLL_SECONDS=10
LSOC_FFVB_INTERVAL_MINUTES=15
LSOC_MATCH_BEFORE_MINUTES=75
LSOC_MATCH_AFTER_MINUTES=150
LSOC_MATCH_COURTS=3
# Rencontres reçues par le club : rattachées au gymnase local de même nom.
LSOC_FFVB_HOME_PREFIX=LSO COLOMBES
# PDF des licences : bucket S3 en lecture publique. En développement, le S3 simulé de
# compose.yaml (S3Mock) ; en production, laisser LSOC_S3_ENDPOINT_URL et LSOC_S3_PUBLIC_URL vides
# pour AWS.
LSOC_S3_BUCKET=lsoc-licences
LSOC_S3_REGION=eu-west-3
LSOC_S3_ENDPOINT_URL=http://localhost:9090
LSOC_S3_PUBLIC_URL=
LSOC_S3_ACCESS_KEY=dev
LSOC_S3_SECRET_KEY=dev
